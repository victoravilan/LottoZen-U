{
  "appId": "com.lottozen.ultra",
  "appName": "LottoZen Ultra",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0d0521",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
